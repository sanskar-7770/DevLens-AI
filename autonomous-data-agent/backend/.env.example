# Copy to backend/.env. Never put this key in frontend variables or source code.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternate model: must support generateContent and structured JSON.
GEMINI_FALLBACK_MODEL=
# LLM_MODEL remains supported when GEMINI_MODEL is unset.
# LLM_API_KEY is accepted as a fallback if GEMINI_API_KEY is unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
